# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/meu-banco

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Redis
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AWS (Cloud Storage)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=meu-banco-docs

# Orange Money API
ORANGE_MONEY_API_URL=https://api.orange.com/guinea-bissau
ORANGE_MONEY_CLIENT_ID=your-client-id
ORANGE_MONEY_CLIENT_SECRET=your-client-secret

# Mobile Money API
MOBILE_MONEY_API_URL=https://api.mobilemoney.com
MOBILE_MONEY_API_KEY=your-api-key

# IBAN / PIX Integration
PIX_API_URL=https://api.pix.com/v2
PIX_CLIENT_ID=your-pix-client-id
PIX_CLIENT_SECRET=your-pix-client-secret

# Bank Integration
BANK_API_URL=https://api.bank.com/integration
BANK_API_KEY=your-bank-api-key

# Google Cloud (AI Chat)
GOOGLE_CLOUD_API_KEY=your-gcp-api-key

# OpenAI (AI Support)
OPENAI_API_KEY=your-openai-api-key
