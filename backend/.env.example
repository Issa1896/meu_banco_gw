# Server
PORT=3000
NODE_ENV=development
# Origens permitidas (CORS e Socket.IO), separadas por vírgula. Nunca "*" em produção.
FRONTEND_URL=http://localhost:5173
# Número de proxies na frente da API (ex.: 1 atrás de Nginx/load balancer)
# TRUST_PROXY=1

# Database
# Precisa ser replica set (transações). Em dev, se o Mongo não estiver
# disponível, usa-se um replica set em memória (desligue com ALLOW_IN_MEMORY_DB=false).
# Em produção o banco em memória nunca é usado.
MONGODB_URI=mongodb://localhost:27017/meu-banco
# ALLOW_IN_MEMORY_DB=false

# Senhas das contas de desenvolvimento (só no banco em memória)
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

# JWT — segredos SEPARADOS por tipo de token (obrigatórios em produção, mín. 32 caracteres)
# Gere cada um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Em desenvolvimento, só JWT_SECRET basta (os outros derivam dele).
JWT_SECRET=dev-only-secret-change-in-production
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_MFA_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (segredos 2FA etc.) — de preferência 32 bytes em base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=dev-only-encryption-key-change-in-production

# Redis
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MeuBanco GW <no-reply@meubanco.gw>
# Sem SMTP_HOST em desenvolvimento, o email de reset de senha aparece no log (nível debug)

# AWS (Cloud Storage)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=meu-banco-docs

# Orange Money API
ORANGE_MONEY_API_URL=https://api.orange.com/guinea-bissau
ORANGE_MONEY_CLIENT_ID=your-client-id
ORANGE_MONEY_CLIENT_SECRET=your-client-secret

# Mobile Money API
MOBILE_MONEY_API_URL=https://api.mobilemoney.com
MOBILE_MONEY_API_KEY=your-api-key

# IBAN / PIX Integration
PIX_API_URL=https://api.pix.com/v2
PIX_CLIENT_ID=your-pix-client-id
PIX_CLIENT_SECRET=your-pix-client-secret

# Bank Integration
BANK_API_URL=https://api.bank.com/integration
BANK_API_KEY=your-bank-api-key

# Google Cloud (AI Chat)
GOOGLE_CLOUD_API_KEY=your-gcp-api-key

# OpenAI (AI Support)
OPENAI_API_KEY=your-openai-api-key
